# 個人の設定の見本。コピーして自分の値に書き換える (コピーしたファイルは git の対象外)
#   cp remote_gamepad.env.example remote_gamepad.env
# 書式は KEY=VALUE のみ (bash と PowerShell の両方から読む)。同名の環境変数があればそちらが優先

# 自宅の PC の Tailscale IP (自宅の PC で tailscale ip -4)。transport_sign.* で使う
IP=x.x.x.x
# iPhone の IP (iPhone の「設定 → Wi-Fi → (i)」)。home_desktop_controll.sh と transport_sign.* で使う
IPHONEIP=x.x.x.x
# 転送に使う UDP ポート。remote_desktop_contoll.sh と transport_sign.* で同じ値になる
NUMBER=40000
